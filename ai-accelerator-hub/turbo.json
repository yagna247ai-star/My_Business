{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "**/.env.*local"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ],
      "passThroughEnv": [
        "DATABASE_URL",
        "DATABASE_URL_UNPOOLED",
        "NEXTAUTH_SECRET",
        "NEXTAUTH_URL",
        "APP_URL",
        "GEMINI_API_KEY",
        "DEFAULT_TENANT_SLUG",
        "TENANT_RESOLUTION_ORDER",
        "JWT_ACCESS_EXPIRES",
        "JWT_REFRESH_EXPIRES",
        "RATE_LIMIT_WINDOW_MS",
        "RATE_LIMIT_MAX_REQUESTS",
        "AI_TENANT_MONTHLY_BUDGET_USD",
        "AI_USER_DAILY_BUDGET_USD",
        "FEATURE_PAYMENTS_MOCK_FALLBACK",
        "FEATURE_AI_COACH",
        "FEATURE_GITHUB_LAB",
        "FEATURE_NEO4J_GRAPH",
        "VERCEL",
        "VERCEL_ENV",
        "VERCEL_PROJECT_PRODUCTION_URL"
      ]
    },
    "lint": {},
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {},
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "db:seed": {
      "cache": false
    }
  }
}
