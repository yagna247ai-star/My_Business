{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run vercel-build",
  "git": {
    "deploymentEnabled": false
  },
  "crons": [
    {
      "path": "/api/cron/i18n-fill",
      "schedule": "30 20 * * *"
    },
    {
      "path": "/api/cron/auto-review",
      "schedule": "45 20 * * *"
    },
    {
      "path": "/api/cron/link-health",
      "schedule": "15 21 * * *"
    },
    {
      "path": "/api/cron/identity-merge",
      "schedule": "30 21 * * *"
    }
  ]
}
