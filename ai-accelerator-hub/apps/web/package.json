{
  "name": "web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 3000",
    "build": "prisma generate --schema ../../packages/db/prisma/schema.prisma && NODE_ENV=production next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "test": "vitest run",
    "test:pure": "vitest run --config vitest.pure.config.ts",
    "test:e2e": "playwright test",
    "dev:webpack": "next dev -p 3000",
    "vercel-build": "prisma generate --schema ../../packages/db/prisma/schema.prisma && sh scripts/release-db.sh && npm run build",
    "seed:content": "cd ../../packages/db && TENANT_SLUG=${DEFAULT_TENANT_SLUG:-demo} npx tsx prisma/seed-data-analytics.ts",
    "smoke:role": "cd ../../packages/db && npx tsx prisma/smoke-role.ts",
    "typecheck": "tsc --noEmit -p .",
    "test:db": "vitest run",
    "lint:ci": "next lint --quiet"
  },
  "dependencies": {
    "@aihub/db": "*",
    "@anthropic-ai/sdk": "^1.4.0",
    "@langchain/anthropic": "^1.6.5",
    "@langchain/core": "^1.4.1",
    "@langchain/google-genai": "^2.3.6",
    "@langchain/langgraph": "1.6.1",
    "@langchain/openai": "^1.8.4",
    "@prisma/client": "^5.19.0",
    "@tanstack/react-query": "^5.59.0",
    "@vercel/blob": "^2.9.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.0",
    "lucide-react": "^0.460.0",
    "neo4j-driver": "^5.26.0",
    "next": "^15.5.29",
    "next-auth": "^5.0.0-beta.32",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.5.2",
    "zod": "^4.6.7",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.7.0",
    "@types/react": "^19.0.1",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.5.29",
    "playwright": "^1.48.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
