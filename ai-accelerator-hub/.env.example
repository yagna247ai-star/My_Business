# ==========================
# AI Accelerator Hub — Environment Template
# Copy to .env and fill. Never commit .env.
# ==========================

# --- Core ---
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace_with_32_char_random_secret_for_dev

# --- Graph Database — Neo4j (PRIMARY) ---
# Used for: journey DAG (level prerequisites), social graph (followers, squads), teams, gamification relationships, recommendations
# Local Docker: bolt://localhost:7687 (browser http://localhost:7474)
# Aura prod: neo4j+s://xxxx.databases.neo4j.io
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=aihud_dev_password
NEO4J_DATABASE=neo4j
# If NEO4J_URI absent, app falls back to Prisma-only (SQLite/Postgres) — graph features disabled with warning

# --- Database — Transactional (Postgres/SQLite) ---
# Local dev without Docker uses SQLite (zero infra). With Docker, Postgres is available.
# For prod: DATABASE_URL=postgresql://user:pass@host:5432/aihub?schema=public&pgbouncer=true
DATABASE_URL="file:./dev.db"

# --- Auth ---
# GitHub OAuth (optional for local; required for GitHub Lab features)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# NextAuth JWT
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# --- Multi-tenancy ---
DEFAULT_TENANT_SLUG=demo
TENANT_RESOLUTION_ORDER=header,subdomain,jwt,path

# --- Redis (optional local) ---
# If not set, app falls back to in-memory for cache/queue/leaderboard (dev only)
REDIS_URL=
# Number of reverse proxies in front of the app (e.g. 1 behind nginx/Vercel). Leave 0 unless a proxy you run appends X-Forwarded-For.
TRUST_PROXY_HOPS=0
# Redis fallback is NOT for production — set REDIS_URL in prod

# --- File Storage (S3 / R2) ---
S3_BUCKET=hub-dev
S3_REGION=ap-south-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# If no S3 creds, uploads are stored to ./uploads (dev only) and AV scan skipped

# --- AI Gateway (LiteLLM) ---
# If not set, AI assistants return deterministic mocks (clearly labeled) — no fake AI
LITELLM_PROXY_URL=
LITELLM_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# AI budgets (micros budget per tenant/month) — enforced even in mock
AI_TENANT_MONTHLY_BUDGET_USD=100
AI_USER_DAILY_BUDGET_USD=5

# --- Payments (Razorpay India) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# If not set, payments run in TEST MODE (mock orders, HMAC check bypassed with warning — never in prod)

# --- Notifications (Novu / SES) ---
NOVU_API_KEY=
SES_REGION=ap-south-1

# --- Observability ---
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
POSTHOG_KEY=

# --- Feature Flags ---
FEATURE_GITHUB_LAB=true
FEATURE_AI_COACH=true
FEATURE_PAYMENTS_MOCK_FALLBACK=true
FEATURE_NEO4J_GRAPH=true

# --- Rate Limit ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

# --- Seed ---
SEED_SUPER_ADMIN_EMAIL=admin@aihub.in
SEED_SUPER_ADMIN_PASSWORD=Admin@12345
