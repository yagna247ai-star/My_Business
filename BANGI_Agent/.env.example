# Bangi MVP — .env.example (copy to .env and fill)
# Backend + Gateway + Web
BANGI_BACKEND_URL=http://localhost:8000
GATEWAY_PORT=8001
# BANGI_API_KEY=change-me-in-prod  # when set, clients must send X-API-Key
# NEXT_PUBLIC_GATEWAY_URL=http://localhost:8001  # web → gateway (empty = same-origin via rewrites)

# Meta Computer-Use
META_API_KEY=your_meta_model_api_key
META_API_URL=https://api.meta.ai/v1

# Hermes CRM
CRM_PATH=../RealEstate/hermes_automation
CONTACTS_CSV=../contacts.csv

# Storage
BANGI_EVENTS=~/.bangi/events.jsonl
BANGI_DB=~/.bangi/bangi.db
